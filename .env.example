# ── Nessie PostgreSQL backend ──────────────────────────────────────────────────
# Production: set these to point at your existing Postgres cluster.
# Local dev: docker-compose.override.yml provides a local postgres — leave these empty.
QUARKUS_DATASOURCE_JDBC_URL=
QUARKUS_DATASOURCE_USERNAME=nessie
QUARKUS_DATASOURCE_PASSWORD=

# ── Bearer token — all Nessie API clients must include this ────────────────────
# Authorization: Bearer <NESSIE_TOKEN>
# Generate with: openssl rand -hex 32
NESSIE_TOKEN=changeme
